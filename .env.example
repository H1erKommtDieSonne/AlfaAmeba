# Docker Compose. Скопируйте файл в .env и замените секреты.
POSTGRES_DB=credit
POSTGRES_USER=credit
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
APP_PORT=8080

# Для запуска Django без Docker можно переопределить подключение:
# DATABASE_URL=sqlite:///./credit_scoring.db

