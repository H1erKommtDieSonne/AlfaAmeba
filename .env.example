# Docker Compose. Скопируйте файл в .env и замените секреты.
# Пароль базы попадает в DATABASE_URL (см. compose.yaml): без символов @ : / ? # —
# иначе адрес не разберётся.
POSTGRES_DB=credit
POSTGRES_USER=credit
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Куки только по HTTPS. Включать, лишь когда сайт открывается по https://.
DJANGO_SECURE_COOKIES=false
APP_PORT=8080
# Только для локальной разработки. Для реального окружения сгенерируйте разные
# длинные случайные токены: очереди LLM и аналитики не должны делить секрет.
LLM_SERVICE_TOKEN=replace-with-a-long-random-token
LLM_JOB_LEASE_SECONDS=600
LLM_RETRY_DELAY_SECONDS=60
ANALYTICS_SERVICE_TOKEN=replace-with-a-different-long-random-token
ANALYTICS_JOB_LEASE_SECONDS=600
ANALYTICS_RETRY_DELAY_SECONDS=60

# Внешний узел проверки документов — только при явном opt-in профиле
# `docker compose --profile node-sender up -d`. Пустой CALLBACK_TOKEN выключает
# приём результатов (callback отвечает 503). API_KEY — ключ Django→узел,
# CALLBACK_TOKEN — отдельный общий секрет узел→Django; это не одно и то же.
DOCUMENT_NODE_ENABLED=false
DOCUMENT_NODE_URL=http://192.168.1.105:8000
DOCUMENT_NODE_API_KEY=
DOCUMENT_NODE_CALLBACK_TOKEN=
DOCUMENT_NODE_TIMEOUT_SECONDS=30
DOCUMENT_NODE_POLL_SECONDS=5
# Провайдер годовой отчётности ООО (mock-bo), например http://192.168.1.105:8010.
# Пусто — узел получает заявку без отчётности.
DOCUMENT_NODE_PROVIDER_URL=
DOCUMENT_NODE_PROVIDER_API_KEY=

# Demo stub-воркер. DEMO_SCENARIO: normal | missing_data | manual_review.
# Неверное значение останавливает воркер с ошибкой конфигурации.
WORKER_ID=local-ml-worker
WORKER_POLL_SECONDS=60
WORKER_HTTP_TIMEOUT_SECONDS=30
DEMO_SCENARIO=normal

# Окружение Django: в Docker по умолчанию config.settings.prod, без Docker — config.settings.dev.
# DJANGO_SETTINGS_MODULE=config.settings.prod

# Запуск без Docker тоже читает этот файл. По умолчанию там SQLite (credit_scoring.db),
# другую базу можно задать так:
# DATABASE_URL=postgres://credit:change-me@127.0.0.1:5432/credit
