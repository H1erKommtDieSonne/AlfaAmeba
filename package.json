{
  "name": "alfa-credit-scoring-assets",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "npm run css:build && npm run js:build",
    "css:build": "tailwindcss -i ./assets/css/input.css -o ./static/css/app.css --minify",
    "css:watch": "tailwindcss -i ./assets/css/input.css -o ./static/css/app.css --watch",
    "js:build": "esbuild ./assets/js/app.js --bundle --minify --outfile=./static/js/app.js"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "alpinejs": "^3.14.9",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.0"
  }
}

